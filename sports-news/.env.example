# 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채우세요.
#   cp .env.example .env
#
# .env 는 절대 깃에 올라가지 않습니다 (.gitignore에 등록되어 있습니다).
# 값이 로그나 화면에 찍히는 일도 없습니다 (자동 마스킹).

# ── 필수 ───────────────────────────────────────────────

# Claude API 키. https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# 워드프레스 주소. 끝에 / 없이. 예: https://myblog.com
WORDPRESS_URL=

# 워드프레스 로그인 아이디 (이메일 아님)
WORDPRESS_USERNAME=

# 애플리케이션 비밀번호 (로그인 비밀번호가 아닙니다)
#   워드프레스 관리자 → 사용자 → 프로필 → 맨 아래 "애플리케이션 비밀번호"
#   이름을 아무거나 넣고 생성하면 "abcd efgh ijkl mnop qrst uvwx" 형태로 나옵니다.
#   띄어쓰기까지 그대로 붙여넣으면 됩니다.
WORDPRESS_APP_PASSWORD=

# ── 선택 ───────────────────────────────────────────────

# 네이버 데이터랩 검색어트렌드 — 어떤 주제의 관심이 올라오는지.
#   광고 계정도 사업자등록도 필요 없습니다. 개발자센터에서 앱 하나만 등록하면 됩니다.
#   발급 방법: docs/naver-keyword-api.md
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 네이버 검색광고 키워드도구 — 절대 월간 검색수 (선택).
#   광고 계정이 있어야 발급됩니다. 계정 생성이 막히면 위 데이터랩만 써도 됩니다.
NAVER_AD_API_KEY=
NAVER_AD_SECRET=
NAVER_AD_CUSTOMER_ID=

# 워드프레스에 요청할 때 쓸 User-Agent.
#   호스팅 보안(Imunify360 등)이 "봇"이라며 403으로 막을 때만 건드리세요.
#   비워 두면 기본값을 씁니다.
WORDPRESS_USER_AGENT=

# 한 종목당 몇 개의 글을 만들지. 기본 1
CANDIDATES_PER_TOPIC=1

# 1순위 글감이 중복이거나 사실 근거가 부족할 때, 다음 후보를 몇 번까지
# 더 시도할지. 0이면 1순위만 보고 끝냅니다. 기본 2
MAX_EXTRA_CANDIDATES=2

# 사실 확인 때 웹검색 최대 횟수. 늘리면 정확해지지만 비용이 늘어납니다. 기본 8
WEB_SEARCH_MAX_USES=8

# 쓰는 모델. 특별한 이유가 없으면 그대로 두세요.
CLAUDE_MODEL=claude-opus-5
